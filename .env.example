# =============================================================================
# ICHESS Finance — modèle de configuration
# Copier ce fichier vers « .env » puis renseigner les valeurs :
#     cp .env.example .env
#     ./scripts/init-secrets.sh        # génère les clés et demande les mots de passe
#
# Le fichier .env contient des SECRETS : il est exclu de Git (.gitignore).
# Ne jamais le committer, ne jamais le partager par un canal non sécurisé.
# =============================================================================

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# Générer : python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origines autorisées pour les requêtes POST (CSRF) : inclure le domaine public.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Origines CORS autorisées (le SPA est servi par nginx, même origine en prod).
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Mettre à True derrière HTTPS (production).
DJANGO_SECURE_COOKIES=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SECURE_HSTS_SECONDS=0

# -----------------------------------------------------------------------------
# Base de données PostgreSQL (non exposée à l'extérieur du réseau Docker)
# -----------------------------------------------------------------------------
POSTGRES_DB=finbank
POSTGRES_USER=finbank
# Générer : python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=

# -----------------------------------------------------------------------------
# Chiffrement des secrets bancaires au repos (Fernet)
# Générer : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ATTENTION : ne plus changer cette clé après le premier enregistrement des
# identifiants Ecobank, sinon ils devront être ressaisis.
# -----------------------------------------------------------------------------
FIELD_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Comptes initiaux — créés une seule fois au premier démarrage.
# Les mots de passe sont hachés (Argon2id) : ils ne sont jamais stockés en clair
# ni écrits dans les journaux. Laisser vide pour ne pas créer le compte.
#
# IMPORTANT : ces valeurs ne servent QU'AU PREMIER démarrage (bootstrap_users est
# idempotent et ne modifie jamais un compte existant). Après la première connexion
# et le changement de mot de passe obligatoire, videz INITIAL_ADMIN_PASSWORD et
# INITIAL_FINANCE_PASSWORD puis redémarrez le backend : plus aucun mot de passe
# initial ne subsiste dans l'environnement du conteneur.
# -----------------------------------------------------------------------------
INITIAL_ADMIN_USERNAME=Ichessfinadmin
INITIAL_ADMIN_PASSWORD=
INITIAL_FINANCE_USERNAME=Emanuel
INITIAL_FINANCE_PASSWORD=

# -----------------------------------------------------------------------------
# Jetons & sécurité applicative
# -----------------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_MINUTES=480
SESSION_COOKIE_AGE=3600
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
THROTTLE_LOGIN=20/min

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_COMPANY_NAME=ICHESS Finance
APP_CURRENCY=USD
TIME_ZONE=Africa/Kinshasa
LANGUAGE_CODE=fr-fr
DJANGO_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Ecobank — valeurs par défaut proposées dans l'interface d'administration.
# Les identifiants réels se saisissent dans l'application (espace admin), pas ici.
# -----------------------------------------------------------------------------
ECOBANK_BASE_URL=https://apimuat-gateway.ecobank.com
ECOBANK_AUTH_PATH=/corp-auth/api/v2/integration/auth/app/token
ECOBANK_BALANCE_PATH=/corp-account-inquiry/api/v2/integration/account/inquiry/balance
ECOBANK_HTTP_TIMEOUT=30
BANK_SYNC_INTERVAL_MINUTES=30
BANK_SYNC_WORKER_ENABLED=True

# -----------------------------------------------------------------------------
# Reverse proxy / sauvegardes
# -----------------------------------------------------------------------------
NGINX_HTTP_PORT=8080
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=7
