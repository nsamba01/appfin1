# Normalise les fins de ligne : les scripts shell et les configurations Docker
# doivent rester en LF, même sur un poste Windows (sinon le conteneur échoue
# avec des erreurs "\r: command not found").
* text=auto

*.sh            text eol=lf
Dockerfile      text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.py            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.json          text eol=lf
*.md            text eol=lf

# Scripts Windows : CRLF attendu par cmd.exe / PowerShell.
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

*.pdf           binary
*.png           binary
*.jpg           binary
*.ico           binary
